# Copy to .env and fill in real values from the Supabase dashboard
# (Project Settings -> API -> JWT Settings for the legacy HS256 secret).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Dev-only: set true to skip JWT verification (uses a fixed "dev-user" id)
# while testing locally before SUPABASE_JWT_SECRET is configured.
AUTH_DISABLED=false

# Lets the app tell this backend apart from anything else answering on the
# same Wi-Fi, so its network scan can't be answered by an impostor. Leave
# blank — `scripts/run.sh` generates one on first run and prints it, and the
# same string goes into the app under Profile -> server settings.
DISCOVERY_SECRET=

# Browser origins allowed to call this API, as a JSON list. Only needed for
# the Flutter web build — the Android app is a native client and CORS does
# not apply to it. Name the origins; don't use ["*"], which grants every
# site on the internet access to a server sitting on your LAN.
#
#   flutter run -d chrome --web-port=5000
#   CORS_ORIGINS=["http://localhost:5000"]
CORS_ORIGINS=[]

# Powers the real drug-interaction engine (/api/v1/interactions/check).
# Same Groq account the Flutter assistant feature uses — console.groq.com/keys.
GROQ_API_KEY=
