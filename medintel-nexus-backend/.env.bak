# Copy to .env and fill in real values from the Supabase dashboard
# (Project Settings -> API -> JWT Settings for the legacy HS256 secret).
SUPABASE_URL=https://rhrvqnonrjfjexfqewjf.supabase.co
SUPABASE_JWT_SECRET=

# Dev-only: set true to skip JWT verification (uses a fixed "dev-user" id)
# while testing locally before SUPABASE_JWT_SECRET is configured.
AUTH_DISABLED=true

# ── Local LLM ───────────────────────────────────────────────────────────
# Inference runs on this machine — no hosted API, no key, no patient data
# leaving the box. Defaults target Ollama; uncomment to override.
#
#   ollama serve
#   ollama pull qwen2.5:7b-instruct
#
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=              # Ollama needs none; llama.cpp/LM Studio may
# LLM_TIMEOUT_SECONDS=180
# Lets the app verify this is its backend and not something else
# answering on the same Wi-Fi. Generated once; enter it in the app
# under Profile -> server settings.
DISCOVERY_SECRET=188c22dafb79763bb2c179e3871b9680
